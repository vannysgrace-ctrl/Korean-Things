# Copy this file to ".env" and fill in your real values.
# Never commit the real ".env" file — it holds secret keys.

# Get this from @BotFather on Telegram after creating your bot.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Get this from https://console.anthropic.com/ (needed from Stage 2 onward).
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional. Path to the SQLite database file. Leave unset for local
# development — it defaults to a "vocab.db" file next to the project.
# On Railway (or any host with a mounted persistent volume), set this to a
# path inside that volume so the database survives redeploys.
# DB_PATH=/data/vocab.db
